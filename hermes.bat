@echo off
rem ============================================================
rem  Расположение этого файла:
rem    C:\Users\<ВАШ_ПОЛЬЗОВАТЕЛЬ>\bin\hermes.bat
rem
rem  Папка C:\Users\<ВАШ_ПОЛЬЗОВАТЕЛЬ>\bin\ должна быть
rem  добавлена в Windows PATH (переменная среды).
rem
rem  Что делает файл:
rem    Перенаправляет команду hermes из Windows в WSL (Ubuntu),
rem    где реально установлен hermes-agent.
rem ============================================================
wsl bash -lc "hermes %*"
